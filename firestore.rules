rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---------------------------------------------------------
    // 3. Primitive Definition (Global Helpers)
    // ---------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Role helpers
    function isSuperAdmin() {
      return isSignedIn() && 
        (request.auth.token.email != null && 
         (request.auth.token.email.lower() == 'antrippy1@gmail.com' || 
          request.auth.token.email.lower() == 'ath222139@gmail.com'));
    }

    function isManagement() {
      return isSignedIn() && (
        isSuperAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'manager', 'supervisor'])
      );
    }

    match /users/{userId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isManagement());
      allow delete: if isManagement();
    }

    match /attendance/{attendanceId} {
      allow read, list: if isSignedIn() && (isManagement() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && (incoming().userId == request.auth.uid || isManagement());
      allow update, delete: if isManagement();
    }

    match /requests/{requestId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && (isManagement() || resource.data.userId == request.auth.uid || resource.data.requesterId == request.auth.uid);
      allow create: if isSignedIn() && (incoming().userId == request.auth.uid || incoming().requesterId == request.auth.uid);
      allow update: if isManagement();
      allow delete: if isManagement();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && (isManagement() || resource.data.userId == request.auth.uid || resource.data.userId == null);
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isManagement());
      allow delete: if isManagement();
    }

    match /activity_logs/{logId} {
      allow read: if isSignedIn() && (isManagement() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isManagement();
    }

    match /schedules/{scheduleId} {
      allow read: if isSignedIn();
      allow write: if isManagement();
    }

    match /chats/{chatId} {
      allow read: if isSignedIn() && (isManagement() || request.auth.uid in resource.data.participants);
      allow create: if isSignedIn() && (isManagement() || request.auth.uid in request.resource.data.participants);
      allow update: if isSignedIn() && (isManagement() || request.auth.uid in resource.data.participants);
      allow delete: if isSignedIn() && (isManagement() || request.auth.uid in resource.data.participants);
      
      match /messages/{messageId} {
        allow read, write: if isSignedIn() && (chatId.matches('.*' + request.auth.uid + '.*') || isManagement());
      }
    }

    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow write: if isManagement();
    }

    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isManagement();
    }

    match /financial_records/{recordId} {
      allow get, list: if isSignedIn() && (isManagement() || resource.data.userId == request.auth.uid);
      allow create, update, delete: if isManagement();
    }

    match /orders/{orderId} {
      allow read, write: if isManagement();
    }
  }
}
